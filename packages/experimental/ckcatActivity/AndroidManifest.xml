<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ckcat.activity">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name">

        <activity android:name=".MainActivity"
            android:label="@string/app_name"
            android:process="org.ckcat.activity.mainprocess">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SubActivityInProcess"
            android:label="@string/sub_activity"
            android:process="org.ckcat.activity.mainprocess">
            <intent-filter>
                <action android:name="org.ckcat.activity.subactivity.in.process"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity android:name=".SubActivityInNewProcess"
            android:label="@string/sub_activity"
            android:process="org.ckcat.activity.newprocess">
            <intent-filter>
                <action android:name="org.ckcat.activity.subactivity.in.new.process"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

    </application>

</manifest>